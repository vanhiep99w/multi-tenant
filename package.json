{
  "name": "multi-tenant",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "prepare-content": "node scripts/prepare-content.mjs && node scripts/build-source-examples.mjs",
    "predev": "npm run prepare-content",
    "dev": "next dev",
    "prebuild": "npm run prepare-content",
    "build": "next build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "test": "node --test scripts/tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "node --test scripts/tests/docs-kit.browser.mjs"
  },
  "dependencies": {
    "@vanhiep99w/docs-kit": "^0.9.5",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "mermaid": "^11.16.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-directive": "^4.0.0",
    "remark-github-admonitions-to-directives": "^2.1.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "^1.64.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.5.0",
    "typescript": "^5.7.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
